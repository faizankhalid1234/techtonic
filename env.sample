# Session signing secret (any long random string)
JWT_SECRET=change_this_to_a_long_random_secret

# Optional Atlas URI. Locally, auth/orders use ./data/*.json when unset.
# On Vercel, signup still works without Mongo (signed account cookie fallback).
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/techtonic?retryWrites=true&w=majority

# Optional: WhatsApp order button in header (digits only, country code, no +)
# Example Pakistan: 923001234567
NEXT_PUBLIC_WHATSAPP_PHONE=
